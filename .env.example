# Supabase Development Environment Configuration
#
# These variables are used for local Supabase development.
# Copy this file to .env.local and fill in the values from your local Supabase environment.
#
# Get these values by running:
#   npx supabase start
#
# Then look for the output like:
#   API URL: http://localhost:54321
#   anon key: eyJ...

# Supabase Project URL
# Local development URL (starts with http://localhost)
VITE_SUPABASE_URL=http://localhost:54321

# Supabase Anonymous Key
# Safe to use in frontend - restricted by Row Level Security policies
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ⚠️ IMPORTANT SECURITY NOTES ⚠️
#
# NEVER expose these in version control:
# - SUPABASE_SERVICE_ROLE_KEY (backend only)
# - Database passwords
# - API secrets
#
# The .env.local file is gitignored and should never be committed.
# .env.example contains placeholder values only.
#
# Phase 2C (Authentication) will add Supabase Auth configuration.
