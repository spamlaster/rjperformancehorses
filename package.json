{
  "name": "rjperformancehorses",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "api": "cd api && PHP_CLI_SERVER_WORKERS=4 php artisan serve --host=127.0.0.1 --port=8000",
    "db:reset": "cd api && php artisan migrate:fresh --seed",
    "test:api": "cd api && php artisan test",
    "test:browser": "node tests/browser.mjs",
    "test:admin": "node tests/admin-browser.mjs",
    "test:riders": "node tests/riders-browser.mjs",
    "test": "npm run test:api && npm run test:browser && npm run test:admin && npm run test:riders"
  },
  "dependencies": {
    "date-fns": "^2.30.0",
    "pinia": "^2.1.4",
    "vue": "^3.3.4",
    "vue-router": "^4.2.4",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "@vitejs/plugin-vue": "^4.3.4",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.47.0",
    "eslint-plugin-vue": "^9.17.0",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.1.6",
    "vite": "^4.4.9",
    "vue-tsc": "^3.1.0"
  }
}
